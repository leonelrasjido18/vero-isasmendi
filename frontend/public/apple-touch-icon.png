<svg xmlns="http://www.w3.org/2000/svg" width="180" height="180" viewBox="0 0 180 180">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f0e4dc"/>
      <stop offset="100%" stop-color="#e8d4c4"/>
    </linearGradient>
    <linearGradient id="txt" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#d4a574"/>
      <stop offset="50%" stop-color="#c4956a"/>
      <stop offset="100%" stop-color="#a07850"/>
    </linearGradient>
  </defs>
  <rect width="180" height="180" rx="40" ry="40" fill="url(#bg)"/>
  <text x="90" y="90" font-family="Georgia,serif" font-size="83" font-weight="300"
    text-anchor="middle" dominant-baseline="central" fill="url(#txt)">VI</text>
</svg>